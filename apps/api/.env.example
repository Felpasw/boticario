NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Postgres (matches docker-compose.yml at the repo root)
DATABASE_URL=postgresql://boticario:boticario@localhost:5434/boticario?schema=public

# Admin user seeded by `pnpm --filter api db:seed`
SEED_ADMIN_EMAIL=admin@boticario.local
SEED_ADMIN_PASSWORD=change-me-dev
SEED_ADMIN_NAME=Admin

# Secret for MAC address HMAC-SHA256 hashing. Rotate per environment.
MAC_HASH_SECRET=change-me-dev-secret

# Shared secret for POST /connections ingest (header X-Ingest-Key).
# INGEST_USER_EMAIL points to the User the inserted connections belong to.
INGEST_API_KEY=change-me-dev-ingest-key
INGEST_USER_EMAIL=admin@boticario.local
